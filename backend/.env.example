# Heal The World Foundation - Environment Variables
# Copy this to .env and fill in your values

# Flask
FLASK_ENV=production
SECRET_KEY=your_super_secret_random_key_here
PORT=5000

# Database (Render PostgreSQL URL)
DATABASE_URL=postgresql://user:password@hostname:5432/healtheworld

# Email (SendGrid for production)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@healtheworld.org
MAIL_PASSWORD=your_app_password

# Cloud Storage (Cloudinary - optional)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=healtheworld

# Frontend URL (for CORS)
FRONTEND_URL=https://heal-the-world-foundation.onrender.com
